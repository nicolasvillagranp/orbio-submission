# --- LiveKit (self-hosted) ---
# URL del servidor LiveKit (http/https para la API; ws/wss lo deriva el cliente)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=un_secreto_largo_de_al_menos_32_caracteres_1234

# --- Zadarma (Configuración -> Conexión SIP) ---
ZADARMA_SIP_SERVER=sip.zadarma.com
ZADARMA_SIP_LOGIN=123456
ZADARMA_SIP_PASSWORD=tu_password_sip
# udp (por defecto) o tcp. Usa tcp si las llamadas fallan con "sip request timed out"
# (el router bloquea las respuestas UDP al 5060). Tras cambiarlo:
#   python telephony/create_outbound_trunk.py --recreate
ZADARMA_SIP_TRANSPORT=
# API de Zadarma (Configuración -> API y webhooks): permite cambiar el CallerID
# y consultar saldo/números desde el código, sin entrar en la web.
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
# Número que verá el destinatario. Tiene que ser un número tuyo y activo en
# Zadarma. Vacío = el CallerID que tenga la línea en el panel.
# "auto" = uno al azar entre tus números activos que no esté en otra llamada.
ZADARMA_CALLER_ID=
# Opcional: limita "auto" a estos números (separados por comas, solo dígitos)
ZADARMA_CALLER_IDS=

# --- Prueba ---
# Tu número personal, en formato internacional
MY_PHONE_NUMBER=+34600111222
LIVEKIT_ROOM=prueba

# --- Agente (opcional) ---
# Si se define, cada llamada despacha este agente a la sala. Si el agente aún no
# está corriendo, la llamada funciona igual.
# El agente de voz (voice/agent.py) se registra como zadarma-agent.
AGENT_NAME=

# --- Voz: speech-to-text y text-to-speech ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Screening pipeline ---
ANTHROPIC_API_KEY=
JEV=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=
GOOGLE_MAPS_API_KEY=
NOMINATIM_CONTACT=

# Recruiter web app: call worker and demo reset (laptop only, never in Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Numbers the worker may dial, comma-separated, or * for any (default: MY_PHONE_NUMBER only)
CALL_ALLOWLIST=
